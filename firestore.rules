rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if true;
    }
    match /sync_profiles/{profileId}/{document=**} {
      allow read, write: if true;
    }
    match /sync_profiles/{profileId} {
      allow read, write: if true;
    }
  }
}
